{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
      }
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "CatalogBaseUrl": "http://localhost:5001/",
    "OrderBaseUrl": "http://localhost:5002/",
    "InventoryBaseUrl": "http://localhost:5003/",
    "PaymentBaseUrl": "http://localhost:5004/"
  }
}