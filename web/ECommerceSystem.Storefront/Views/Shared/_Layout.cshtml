@* File: web/ECommerceSystem.Storefront/Views/Shared/_Layout.cshtml
   Sidebar app shell adapted from the DGCS Enrollment System, red-and-white palette, Lucide icons. *@
@inject CartService Cart
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string ActiveIf(params string[] names) =>
        names.Any(n => string.Equals(controller, n, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;

    var cartCount = Cart.ItemCount;
    var customer = Cart.GetCustomer();
    var hasName = !string.IsNullOrWhiteSpace(customer?.Name);
    var shopperName = hasName ? customer!.Name : "Guest shopper";
    var shopperEmail = string.IsNullOrWhiteSpace(customer?.Email) ? "No account needed" : customer!.Email;
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i data-lucide="shopping-bag"></i></span>
                <span>
                    <span class="title">E-Commerce System</span>
                    <span class="subtitle">Online tech store</span>
                </span>
            </a>

            <a class="user-card @ActiveIf("Orders")" asp-controller="Orders" asp-action="Index" title="My orders">
                <span class="avatar">@Display.Initials(hasName ? shopperName : string.Empty)</span>
                <span class="user-meta">
                    <span class="name">@shopperName</span>
                    <span class="uid">@shopperEmail</span>
                </span>
                <i class="user-go" data-lucide="chevron-right"></i>
            </a>

            <nav>
                <div class="nav-group-label">Shop</div>
                <div class="nav-group">
                    <a class="nav-link-item @ActiveIf("Home", "Products")" asp-controller="Home" asp-action="Index">
                        <i data-lucide="store"></i> Products
                    </a>
                    <a class="nav-link-item @ActiveIf("Cart")" asp-controller="Cart" asp-action="Index">
                        <i data-lucide="shopping-cart"></i> Cart
                        @if (cartCount > 0)
                        {
                            <span class="nav-count">@cartCount</span>
                        }
                    </a>
                    <a class="nav-link-item @ActiveIf("Checkout")" asp-controller="Checkout" asp-action="Index">
                        <i data-lucide="credit-card"></i> Checkout
                    </a>
                </div>

                <div class="nav-group-label">My Account</div>
                <div class="nav-group">
                    <a class="nav-link-item @ActiveIf("Orders")" asp-controller="Orders" asp-action="Index">
                        <i data-lucide="package"></i> My Orders
                    </a>
                </div>

                <div class="nav-group-label">System</div>
                <div class="nav-group">
                    <a class="nav-link-item @ActiveIf("Status")" asp-controller="Status" asp-action="Index">
                        <i data-lucide="activity"></i> Service Status
                    </a>
                    <a class="nav-link-item" href="http://localhost:15672" target="_blank" rel="noopener">
                        <i data-lucide="rabbit"></i> RabbitMQ UI
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <div class="test-card-note">
                    <strong><i data-lucide="flask-conical"></i> Test payments only</strong>
                    4242 4242 4242 4242 succeeds<br />
                    4000 0000 0000 0002 is declined
                </div>
                <form asp-controller="Cart" asp-action="Reset" method="post"
                      data-confirm="Start over? This empties your cart and forgets your name and email on this browser.">
                    <button type="submit" class="sign-out"><i data-lucide="rotate-ccw"></i> Start over</button>
                </form>
            </div>
        </aside>

        <div class="nav-backdrop" id="navBackdrop"></div>

        <main class="main-content">
            <div class="topbar">
                <button type="button" class="nav-toggle" id="navToggle" aria-label="Open menu">
                    <i data-lucide="menu"></i>
                </button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-actions">
                    <a class="topbar-link" asp-controller="Orders" asp-action="Index">
                        <i data-lucide="package"></i><span>My orders</span>
                    </a>
                    <a class="cart-btn" asp-controller="Cart" asp-action="Index" aria-label="Cart">
                        <i data-lucide="shopping-cart"></i><span class="cart-text">Cart</span>
                        @if (cartCount > 0)
                        {
                            <span class="cart-badge">@(cartCount > 99 ? "99+" : cartCount.ToString())</span>
                        }
                    </a>
                </div>
            </div>

            <div class="main-body">
                @RenderBody()
            </div>

            <footer class="app-footer">
                <span>E-Commerce System &middot; Group midterm project &middot; Dusty Cruz, Laurence Mirandilla, CJ Bello</span>
                <span>Demo store &middot; no real payments</span>
            </footer>
        </main>
    </div>

    <div id="toast-container" aria-live="polite"></div>

    <div class="confirm-overlay" id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="confirm-box">
            <h3 id="confirmTitle">Please confirm</h3>
            <p id="confirmMessage"></p>
            <div class="confirm-actions">
                <button type="button" class="btn btn-outline-brand" id="confirmCancel">Cancel</button>
                <button type="button" class="btn btn-brand" id="confirmOk">Confirm</button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast(@Html.Raw(Json.Serialize(successMessage)), 'success'); });</script>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast(@Html.Raw(Json.Serialize(errorMessage)), 'error'); });</script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>