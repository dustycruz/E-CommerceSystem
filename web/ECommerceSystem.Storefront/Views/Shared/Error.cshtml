@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="content-card">
    <div class="empty-state">
        <i data-lucide="triangle-alert"></i>
        <h3>Something went wrong</h3>
        <p>We could not finish your request. Please try again in a moment.</p>
        @if (!string.IsNullOrEmpty(Model.CorrelationId))
        {
            <p class="trace">Trace ID <code>@Model.CorrelationId</code></p>
        }
        @if (Model.ShowRequestId)
        {
            <p class="trace">Request ID <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Back to the shop</a>
    </div>
</div>