@model OrderDetailsViewModel
@{
    ViewData["Title"] = "Order details";
    var notFound = new EmptyStateViewModel("search-x", "Order not found", "Check the link, or look the order up by email on My orders.", "Go to My orders", Url.Action("Index", "Orders"));
}

<a class="back-link" asp-controller="Orders" asp-action="Index"><i data-lucide="arrow-left"></i> My orders</a>

@if (Model.NotFound)
{
    <div class="content-card"><partial name="_EmptyState" model="notFound" /></div>
}
else if (Model.Order is null)
{
    <partial name="_ProblemAlert" model="Model.Problem!" />
    <a class="btn btn-outline-brand" href="@Context.Request.Path"><i data-lucide="refresh-cw"></i> Try again</a>
}
else
{
    var order = Model.Order;

    <div class="page-head">
        <div>
            <h1 class="page-title">Order #@Display.ShortId(order.Id)</h1>
            <p class="page-subtitle">Placed @Display.LocalTime(order.CreatedAtUtc) by @order.CustomerName</p>
        </div>
    </div>

    <div class="details-grid">
        <div>
            <partial name="_OrderLive" model="order" />
        </div>

        <aside class="sticky-aside">
            <div class="panel-card">
                <div class="panel-head"><i data-lucide="receipt"></i> Order summary</div>
                <div class="panel-body">
                    @foreach (var item in order.Items)
                    {
                        <div class="summary-line">
                            <span>
                                @item.ProductName
                                <span class="qty">@item.Quantity &times; @Display.Money(item.UnitPrice) &middot; @item.Sku</span>
                            </span>
                            <strong>@Display.Money(item.LineTotal)</strong>
                        </div>
                    }
                    <div class="summary-row total"><span>Total</span><span>@Display.Money(order.TotalAmount)</span></div>

                    <dl class="detail-list">
                        <div><dt>Customer</dt><dd>@order.CustomerName</dd></div>
                        <div><dt>Email</dt><dd>@order.CustomerEmail</dd></div>
                        <div><dt>Card</dt><dd>&bull;&bull;&bull;&bull; @order.CardLast4</dd></div>
                        <div><dt>Order ID</dt><dd><code>@order.Id</code></dd></div>
                        <div><dt>Trace ID</dt><dd><code>@order.CorrelationId</code></dd></div>
                        @if (order.SimulateFailureAfterPayment)
                        {
                            <div><dt>Demo</dt><dd>Failure after payment</dd></div>
                        }
                    </dl>
                </div>
            </div>
            <div class="summary-actions">
                <a class="btn btn-brand btn-block" asp-controller="Home" asp-action="Index"><i data-lucide="store"></i> Continue shopping</a>
                <a class="btn btn-outline-brand btn-block" asp-controller="Orders" asp-action="Index" asp-route-email="@order.CustomerEmail"><i data-lucide="package"></i> All my orders</a>
            </div>
        </aside>
    </div>
}